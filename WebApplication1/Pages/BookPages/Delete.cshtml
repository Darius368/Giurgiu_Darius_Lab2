@page
@model WebApplication1.Pages.BookPages.DeleteModel

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>

<div>
    <h4>Book</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">
            Book Title
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Book.Title)
        </dd>

        <dt class="col-sm-2">
            Author
        </dt>
        <dd class="col-sm-10">
            @(Model.Book.Authors != null
                ? Model.Book.Authors.FirstName + " " + Model.Book.Authors.LastName
                : "Fără autor")
        </dd>

        <dt class="col-sm-2">
            Price
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Book.Price)
        </dd>

        <dt class="col-sm-2">
            PublishingDate
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Book.PublishingDate)
        </dd>

        <dt class="col-sm-2">
            Publisher
        </dt>
        <dd class="col-sm-10">
            @(Model.Book.Publisher?.PublisherName ?? "Fără editură")
        </dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Book.ID" />

        <input type="submit"
               value="Delete"
               class="btn btn-danger" />

        <a asp-page="./Index">Back to List</a>
    </form>
</div>
